{
  "recommendations": [
{% if language == 'java' %}
    // ── Java ─────────────────────────────────────────────────────────────
    "vscjava.vscode-java-pack",
    "vmware.vscode-spring-boot",
    "redhat.vscode-xml",
{% else %}
    // ── Python ────────────────────────────────────────────────────────────
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "ms-toolsai.jupyter",
    "charliermarsh.ruff",
    "njpwerner.autodocstring",
{% endif %}
    // ── Git (sin GitLens — usar el SCM nativo + estas) ────────────────────
    "mhutchie.git-graph",             // árbol de commits visual, limpio
    "donjayamanne.githistory",        // historial por archivo y línea
    "GitHub.vscode-pull-request-github", // PRs y issues directo en VSCode
    "vivaxy.vscode-conventional-commits", // commits semánticos (Ctrl+Shift+G C)
    // ── Archivos ──────────────────────────────────────────────────────────
    "mechatroner.rainbow-csv",
    "yzhang.markdown-all-in-one",
    // ── Utilidades ────────────────────────────────────────────────────────
    "ms-vscode.makefile-tools",
    "usernamehw.errorlens"            // errores inline sin abrir Problems
  ]
}
